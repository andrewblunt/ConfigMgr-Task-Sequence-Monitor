<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="MainWindow" Height="750" Width="1502" WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="PageBrush" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="TextBrush" Color="#1E293B"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1E40AF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.55"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource PageBrush}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="0,0,2,0" Width="auto">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top row: ConfigMgr controls + Configuration buttons side by side -->
        <DockPanel Grid.Row="0" Margin="5,10,5,0" VerticalAlignment="Top">
            <GroupBox Header="Configuration" DockPanel.Dock="Right" Margin="5,0,0,0" VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" x:Name="SettingsButton" Content="Settings" HorizontalAlignment="Left" Margin="0,10,0,0" VerticalAlignment="Top" Width="83" Height="29"/>
                    <Button Grid.Row="1" x:Name="ReportButton" Content="Reports" HorizontalAlignment="Left" Margin="0,10,0,0" Width="83" Height="34" Padding="4,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                </Grid>
            </GroupBox>
            <GroupBox Header="ConfigMgr" VerticalAlignment="Top">
                <StackPanel>
                    <Grid VerticalAlignment="Top">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="Task Sequence:" HorizontalAlignment="Left" Margin="0,7,0,0" VerticalAlignment="Top" Width="96"/>
                            <ComboBox Grid.Column="1" x:Name="TaskSequence" HorizontalAlignment="Left" Margin="0,7,0,0" VerticalAlignment="Top" Width="356" Height="26"/>
                            <Label Grid.Column="2" Content="Time Period &#xD;&#xA;(Hours):" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Top" Width="73" Height="46"/>
                            <TextBox Grid.Column="3" x:Name="TimePeriod" HorizontalAlignment="Left" Height="26" Margin="0,8,0,0" TextWrapping="Wrap" Text="8" VerticalAlignment="Top" Width="48" TextAlignment="Center" VerticalContentAlignment="Center"/>
                            <Label Grid.Column="4" Content="Show Disabled &#xD;&#xA;Steps:" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Top" Width="92" Height="46"/>
                            <CheckBox Grid.Column="5" x:Name="DisabledSteps" Content="" HorizontalAlignment="Left" Margin="0,18,0,0" VerticalAlignment="Top" IsChecked="True"/>
                            <Label Grid.Column="6" Content="Show Skipped &#xD;&#xA;Steps:" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Top" Width="85" Height="46"/>
                            <CheckBox Grid.Column="7" x:Name="SkippedSteps" Content="" HorizontalAlignment="Left" Margin="0,18,0,0" VerticalAlignment="Top" IsChecked="True"/>
                            <Label Grid.Column="8" Content="Errors &#xD;&#xA;Only:" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Top" Width="41" Height="46"/>
                            <CheckBox Grid.Column="9" x:Name="ErrorsOnly" Content="" HorizontalAlignment="Left" Margin="0,18,0,0" VerticalAlignment="Top"/>
                            <Label Grid.Column="10" Content="Success &#xD;&#xA;Code:" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Top" Width="51" Height="46"/>
                            <TextBox Grid.Column="11" x:Name="SuccessCode" Text="0,3010" HorizontalAlignment="Left" Height="26" Margin="0,8,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" VerticalContentAlignment="Center"/>
                            <Label Grid.Column="12" Content="Error &#xD;&#xA;Count:" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="13" x:Name="ErrorCount" HorizontalAlignment="Left" Height="26" Margin="0,8,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="37" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" IsReadOnly="True"/>
                            <Label Grid.Column="14" Content="Refresh Period &#xD;&#xA;(Minutes):" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center" Height="46"/>
                            <TextBox Grid.Column="15" x:Name="RefreshPeriod" HorizontalAlignment="Left" Height="26" Margin="0,8,0,0" TextWrapping="Wrap" Text="5" VerticalAlignment="Top" Width="33" TextAlignment="Center" VerticalContentAlignment="Center"/>
                        </Grid>
                    </Grid>
                    <Grid Margin="0,10,0,0" VerticalAlignment="Top">
                        <Grid>
                            <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Content="Action Name:" HorizontalAlignment="Left" Margin="0,7,0,0" VerticalAlignment="Top" Width="96"/>
                            <ComboBox Grid.Column="1" x:Name="ActionName" HorizontalAlignment="Left" Margin="0,7,0,0" VerticalAlignment="Top" Width="356" Height="26"/>
                            <Label Grid.Column="2" Content="ComputerName:" HorizontalAlignment="Left" Margin="0,8,0,0" VerticalAlignment="Top"/>
                            <ComboBox Grid.Column="3" x:Name="ComputerName" HorizontalAlignment="Left" Margin="0,7,0,0" VerticalAlignment="Top" Width="160" Height="26" IsEditable="True"/>
                            <Label Grid.Column="4" Content="Device Count:" HorizontalAlignment="Left" Margin="10,8,0,0" VerticalAlignment="Top"/>
                            <TextBox Grid.Column="5" x:Name="DeviceCount" HorizontalAlignment="Left" Height="26" Margin="0,8,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="37" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" IsReadOnly="True"/>
                            <Label Grid.Column="6" Content="Build Versions:" HorizontalAlignment="Left" Margin="10,8,0,0" VerticalAlignment="Top"/>
                            <TextBox Grid.Column="7" x:Name="BuildExt" HorizontalAlignment="Left" Height="26" Margin="0,8,0,0" VerticalAlignment="Top" Width="220" VerticalContentAlignment="Center" IsReadOnly="True"/>
                            <Button Grid.Column="8" x:Name="RefreshNow" Content="Refresh Now!" HorizontalAlignment="Left" Margin="10,7,0,0" VerticalAlignment="Top" Width="95" Height="29"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </GroupBox>
        </DockPanel>

        <!-- Result DataGrid -->
        <GroupBox Grid.Row="1" Header="Result" Margin="5,10,0,0" VerticalAlignment="Stretch">
            <Grid Margin="0,0,0,0">
                <DataGrid x:Name="DataGrid" AutoGenerateColumns="False" Margin="10,0,10,0" VerticalAlignment="Stretch" Height="Auto" IsReadOnly="True" HorizontalGridLinesBrush="#FF297566" VerticalGridLinesBrush="#FF489183">
                    <!-- Keep the selected row readable with a consistent native WPF style. -->
                    <DataGrid.Resources>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                            <Style.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsSelected" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="#FF69969C"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </MultiTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FF012E34"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsSelected" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="#FF69969C"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </MultiTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FF012E34"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding Path=IsGreyed}" Value="True">
                                    <Setter Property="Background" Value="#FFE4E4E4"/>
                                    <Setter Property="Foreground" Value="#FF777777"/>
                                </DataTrigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FF3399FF"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="24" MinWidth="24" CanUserResize="False">
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Style.Triggers>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                                <Condition Property="IsSelected" Value="False"/>
                                            </MultiTrigger.Conditions>
                                            <Setter Property="Background" Value="#FF69969C"/>
                                        </MultiTrigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#FF012E34"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding Path=IconPath}" Width="15" Height="15" Stretch="Uniform" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="ComputerName" Binding="{Binding Path=ComputerName}" />
                        <DataGridTextColumn Header="GUID" Binding="{Binding Path=GUID}" Visibility="Hidden"/>
                        <DataGridTextColumn Header="Connection Type" Binding="{Binding Path=Connection Type}" />
                        <DataGridTextColumn Header="BuildExt" Binding="{Binding Path=BuildExt}" />
                        <DataGridTextColumn Header="Model" Binding="{Binding Path=Model0}" />
                        <DataGridTextColumn Header="BIOSVersion" Binding="{Binding Path=BIOSVersion}" />
                        <DataGridTextColumn Header="ExecutionTime" Binding="{Binding Path=ExecutionTime}" />
                        <DataGridTextColumn Header="Step" Binding="{Binding Path=Step}" />
                        <DataGridTextColumn Header="ActionName" Binding="{Binding Path=ActionName}" />
                        <DataGridTextColumn Header="GroupName" Binding="{Binding Path=GroupName}" />
                        <DataGridTextColumn Header="LastStatusMsgName" Binding="{Binding Path=LastStatusMsgName}" />
                        <DataGridTextColumn Header="ExitCode" Binding="{Binding Path=ExitCode}"/>
                        <DataGridTextColumn Header="Record" Binding="{Binding Path=Record}" Visibility="Hidden"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <!-- Action Output -->
        <GroupBox Grid.Row="2" Header="Action Output" Margin="5,10,0,0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Grid HorizontalAlignment="Stretch">
                <TextBox x:Name="ActionOutput" HorizontalAlignment="Stretch" Margin="10,10,10,10" TextWrapping="Wrap" VerticalAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>
            </Grid>
        </GroupBox>

    </Grid>

</Window>
